{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fearless-inventory",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build/web"
  },
  "routes": [
    { "pattern": "fearless-inventory.drownedwoods.com", "custom_domain": true }
  ]
}
